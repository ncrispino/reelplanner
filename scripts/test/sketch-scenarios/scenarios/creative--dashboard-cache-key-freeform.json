      "t": 7.5,
      "add": [
        {
          "id": "code",
          "type": "text",
          "x": 50,
          "y": 110,
          "text": "export async function GET(req) {\n  const user = await auth(req)\n  const hit = await kv.get(key(user))\n  if (hit) return Response.json(hit)\n  const data = await loadDashboard(user)\n  await kv.set(key(user), data, { ex: 60 })\n  return Response.json(data)\n}",
          "fontSize": 16
        }
      ]
    },
