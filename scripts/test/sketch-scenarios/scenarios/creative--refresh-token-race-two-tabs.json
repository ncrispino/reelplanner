      "t": 54.5,
      "add": [
        {
          "id": "ar_b_reused",
          "type": "arrow",
          "from": "b_post",
          "to": "reused"
        }
      ]
    },
    {
      "t": 59.0,
      "say": "So when B comes in with RT1, the server sees an old token reused, and I think it revokes the whole token family."
    },
    {
      "t": 60.5,
      "restyle": {
