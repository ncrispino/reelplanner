      ]
    },
    {
      "t": 48.5,
      "say": "Hmm, no, tab B's post lands after A's, A's request is already being handled, let me shift that over."
    },
    {
      "t": 50.5,
      "move": {
        "id": "b_post",
        "x": 430,
        "y": 283
      }
    },
    {
      "t": 52.0,
      "say": "And then tab B's request arrives."
