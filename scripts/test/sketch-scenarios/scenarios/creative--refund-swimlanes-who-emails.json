      ]
    },
    {
      "t": 30.0,
      "say": "Actually no, support doesn't check that, the billing service rejects it if it's too old, so that goes down a lane."
    },
    {
      "t": 31.5,
      "move": {
        "id": "check",
        "x": 260,
        "y": 270
