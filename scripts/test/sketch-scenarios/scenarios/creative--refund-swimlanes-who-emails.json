{
  "id": "refund-swimlanes-who-emails",
  "title": "Refund flow as swimlanes, with one step nobody owns",
  "persona": "A backend engineer new to the billing team, drawing the refund process across teams as they understand it from two weeks of tickets.",
  "topic": "how a refund goes from a support ticket to the ledger",
  "realism": "Cross-team processes get drawn as swimlanes because 'who does this step' is the whole question; ownership is the band a box sits in, handoffs are arrows that cross a band, and a step nobody can place gets parked between bands with a question mark.",
  "steps": [
    {
      "t": 2.5,
      "say": "Right, refunds, let me do this as lanes, because half the problem is who does what."
    },
    {
      "t": 4.5,
      "add": [
        {
          "id": "f_support",
          "type": "frame",
          "x": 40,
          "y": 110,
          "width": 840,
          "height": 100,
          "name": "Support"
        }
      ]
    },
    {
      "t": 6.0,
      "add": [
        {
          "id": "f_billing",
          "type": "frame",
          "x": 40,
          "y": 250,
          "width": 840,
          "height": 100,
          "name": "Billing service"
        }
      ]
    },
    {
      "t": 7.0,
      "say": "Four lanes, I think that covers it."
    },
    {
      "t": 7.5,
      "add": [
        {
          "id": "f_pay",
          "type": "frame",
          "x": 40,
          "y": 390,
