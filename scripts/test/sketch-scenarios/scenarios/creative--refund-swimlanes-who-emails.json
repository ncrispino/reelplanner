        {
          "id": "f_ledger",
          "type": "frame",
          "x": 40,
          "y": 530,
          "width": 840,
          "height": 100,
          "name": "Ledger"
        }
      ]
    },
    {
      "t": 12.5,
      "say": "Support on top, then the billing service, then Stripe, and the ledger at the bottom."
    },
    {
      "t": 15.0,
      "add": [
        {
          "id": "ticket",
          "type": "rectangle",
          "x": 60,
          "y": 130,
          "width": 170,
          "height": 60,
          "label": "refund request ticket"
        }
      ]
    },
    {
      "t": 16.0,
      "say": "Customer side first."
    },
    {
      "t": 17.0,
      "add": [
        {
          "id": "approve",
          "type": "rectangle",
          "x": 260,
          "y": 130,
