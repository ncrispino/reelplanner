  "pipelines": [
    {
      "id": "publish",
      "name": "From a YAML file to a live page",
      "edges": [
        "content-build",
        "build-generator",
        "generator-hosting"
      ]
    },
    {
      "id": "search",
      "name": "A search on the site",
      "edges": [
        "build-search",
        "search-generator"
      ]
    }
  ],
  "stage": {
    "kind": "pipeline",
    "why": "This plan produces a static site: content files go through one build and come out as pages. Nothing here exchanges data at runtime, so a node graph with edges would assert something false. The stage reads left to right and ends in the real pages, because pages are what the plan makes. (style guide \u00a718)",
    "chain": [
      {
        "id": "sources",
        "label": "Content files",
        "shows": [
          "albums/",
          "songs/",
          "events/",
          "search.json"
        ]
      },
      {
        "id": "build",
        "label": "Build",
        "shows": [
          "site.json"
        ]
      },
      {
        "id": "pages",
        "label": "Pages",
        "shows": [
          "era",
          "album",
          "song"
        ]
      }
    ],
    "properties": [
      {
        "id": "design",
        "of": "pages",
        "shows": "the pages restyle (serif headings, looser leading)"
      },
      {
        "id": "search",
        "of": "pages",
        "shows": "search.json joins the sources; a search field appears on the song page"
      },
      {
        "id": "hosting",
        "of": "pages",
        "shows": "a host bar above the pages"
      }
    ],
    "rail": {
      "x": 80,
      "y": 150,
      "w": 500,
      "slotH": 90,
      "gap": 20,
      "slots": 6
    }
  },
  "edges_retired": {
    "why": "design\u2192generator and search\u2192generator were build-time relationships drawn as dataflow. Replaced by stage.chain (\u00a718).",
    "was": [
